# Translation API (server-side only — never commit real keys)
# Used by Vite /translate-api plugin in development and by workers/translate-api.js in production.

# DeepL (preferred for speed). Free keys end with :fx → api-free.deepl.com
DEEPL_API_KEY=
# Optional: force free endpoint even without :fx suffix
# DEEPL_API_FREE=1

# Google Cloud Translation API v2 (fallback if DeepL missing/fails)
GOOGLE_TRANSLATE_KEY=

# ---------------------------------------------------------------------------
# Gemma / OpenAI-compatible LLM translator (optional)
# Use any chat-completions endpoint (Spark, Ollama, Groq, local Gemma, etc.)
# ---------------------------------------------------------------------------
# Full URL to chat completions, e.g.:
#   https://spark-e020.tail02df6b.ts.net/api/v1/chat/completions
#   or relative via Vite proxy: /llm-proxy/api/v1/chat/completions
GEMMA_TRANSLATE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=gemma
# Set to 1 to try Gemma BEFORE DeepL/Google (slower, but uses your model first)
# GEMMA_TRANSLATE_FIRST=1
